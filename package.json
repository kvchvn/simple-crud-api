{
  "name": "simple-crud-api",
  "version": "1.0.0",
  "description": "Simple CRUD API",
  "main": "index.js",
  "scripts": {
    "start:dev": "ts-node-dev --respawn src/index.ts",
    "start:dev:multi": "ts-node-dev --respawn src/index.multi.ts",
    "start:prod": "cross-env NODE_ENV=production webpack && node build/index.js",
    "start:prod:multi": "cross-env NODE_ENV=production MODE=multi webpack && node build/index.js",
    "lint": "npx eslint",
    "lint:fix": "npx eslint --fix",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvchvn/simple-crud-api.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kvchvn/simple-crud-api/issues"
  },
  "homepage": "https://github.com/kvchvn/simple-crud-api#readme",
  "devDependencies": {
    "@eslint/json": "^0.13.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.14",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.34.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.41.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "uuid": "^11.1.0"
  }
}
